        <<roll $finalfoundoutlet>>
        <<if $success>>
            <<goto "翻通风口被发现">>
        <<else>>
            <<goto $playerPos.block>>
        <</if>>
    <</link>> <br>    
<<elseif $playerPos.layer==4 &&!$outlet4on>>
    这里的通风口保护板还牢牢地待在原位。<br><br>

    [[破坏|竖井内破坏保护板][$chaos+=2]]<br>
<</if>>



<<if $playerPos.layer==3 && $outlet3on>><<set $playerPos to {layer:3, block:"清道夫休息室-快速浴室"}>>
你爬进那个狭窄的混凝土空间，这里的通风口保护板已经被你打开过了，可以轻易进出。<br>
<<brokeoutletfound>><br>

 <<link "进入室内">>
        <<roll $finalfoundoutlet>>
        <<if $success>>
            <<goto "翻通风口被发现">>
        <<else>>
            <<goto $playerPos.block>>
        <</if>>
    <</link>> <br>    
<<elseif $playerPos.layer==3 &&!$outlet3on>>
    这里的通风口保护板还牢牢地待在原位。<br><br>

    [[破坏|竖井内破坏保护板][$chaos+=2]]
<</if>>


<<if $playerPos.layer==2 && $outlet2on>><<set $playerPos to {layer:2, block:"巡逻队休息室"}>>
你爬进那个狭窄的混凝土空间，这里的通风口保护板已经被你打开过了，可以轻易进出。<br>
<<brokeoutletfound>><br>

 <<link "进入室内">>
        <<roll $finalfoundoutlet>>
        <<if $success>>
            <<goto "翻通风口被发现">>
        <<else>>
            <<goto $playerPos.block>>
        <</if>>
    <</link>> <br>    <br>
<<elseif $playerPos.layer==2 &&!$outlet2on>>
    这里的通风口保护板还牢牢地待在原位。<br><br>

    [[破坏|竖井内破坏保护板][$chaos+=2]]<br>
<</if>>
[[离开|竖井]]




:: 破坏通风口保护板被发现的概率[widget nobr]
<<widget "brokeoutletfound">>
    <<set _initfoundoutlet to random(10,50)>>
    <<set $finalfoundoutlet to (_initfoundoutlet+random(1,Math.max(1,100-$maidtrust)))>>
    <<if $playerPos.layer==2||$playerPos.layer==3||$playerPos.layer==10>>
        <<set $finalfoundoutlet+=15>>
    <</if>>
    <<if $finalfoundoutlet<=25>>
        隔着通风口，外面只有机器运作的轰鸣声。现在出去没人会发现你。<br>
        <<elseif  $finalfoundoutlet<=80>>
        隔着通风口，你听到有人形的脚步声。但她应该离这里有一段距离，不大可能会发现你的行动。<br> 
        <<else>>
        你在这里可以很轻易地听到外界人形的交谈声，现在出去可能不太算是一个明智之举。<br>       
    <</if>>
    <</widget>>


:: 竖井内破坏保护板[nobr]
<<switch $playerPos.layer>>
    <<case 10>>
        <<set $playerPos.block to "后勤休息区">>
    <<case 8>>
        <<set $playerPos.block to "食品部-生产车间-垂直农场">>
    <<case 4>>
        <<set $playerPos.block to "化工部-清洁间">>
    <<case 3>>
        <<set $playerPos.block to "清道夫休息室-快速浴室">>
    <<case 2>>
        <<set $playerPos.block to "巡逻队休息室">>
    <<default>>
        <<set $playerPos.block to "通风竖井-第" + $playerPos.layer + "层">>
<</switch>>
你抓住通风口保护板的栅格口，用力摇晃了几下。<br>
<<roll $fighting>><span style="color:red;">+混乱</span><br><br>
<<set $chaos+=2>>
<<brokeoutletfound>>
<<if $success>>
    <<set State.setVar("$outlet" + $playerPos.layer + "on", true)>>
    随着你的动作，栅格口很快松动了，变得能够被轻易取下。<br><br>
    <<set $finalfoundoutlet+=5>>
    <<link "进入室内">>
        <<roll $finalfoundoutlet>>
        <<if $success>>
            <<goto "翻通风口被发现">>
        <<else>>
            <<goto $playerPos.block>>
        <</if>>
    <</link>> <br>
<<else>>
    你没能破坏保护板，它只是随着你的动作嘎嘎作响了几声。<br><br>
    <<set $finalfoundoutlet+=5>>
    [[再次尝试|竖井内破坏保护板]]<br>
<</if>>
[[暂且放弃|离开竖井]]

:: 翻通风口被发现[nobr]
<<if $playerPos.block=="巡逻队休息室">>
    当你从通风口跳下时，正好面对一个举着武器对着你的巡逻队成员。<br>
    在看清你之后，她脸上的敌意稍微消散了一些。她放下武器，为刚刚的行为向你道歉，她以为你是一只准备从通风管道进行突袭的怪物……<br>
    <<if $playerJob!="巡逻队">>
        不管如何，你的身份被认出来了，巡逻队的人形们礼貌地请你离开她们的休息室。<br>
        <span style="color:red;">-人形的信任</span><<set $maidtrust-=1>><br><br>

        [[好吧|L2流通走廊]]
    <<else>>
        不过她话锋一转，请你下次不要再这样了。<br>
        <span style="color:red;">-人形的信任</span><<set $maidtrust-=1>><br><br>

        [[好吧|巡逻队休息室]]
    <</if>>
<<else>>
爬出通风口时，不巧有几个人形被你这侧的动静吸引了注意力，直直地看向爬出通风口的你。<br>
你能感觉到她们眼中的警惕，但是在她们确认你确实是管理区的人形后，似乎又稍微放松了下来。但你在她们处理器中的形象多少是下降了一点。<br>
        <span style="color:red;">-人形的信任</span><<set $maidtrust-=1>><br><br>

[[继续|$playerPos.block]]
<</if>>
:: GiftSelect [nobr] {"position":"4875,1075","size":"100,100"}
你要向 <<print $giftnpc>> 赠送什么样的礼物呢？赠送的礼物只能从你的持有物中取出。<br><br>

<<set _list = []>>

<<if $inventory>>
  <<for _id, _qty range $inventory>>
    <<if _qty > 0 && $giftDB[_id]>>
      <<set _list.push(_id)>>
    <</if>>
  <</for>>
<</if>>

<<if _list.length > 0>>
  你现在可赠送：<br>
  <<for _id range _list>>
    <<set _def = $giftDB[_id]>>
    <<link "赠送："+_def.name+"（x"+$inventory[_id]+"）">>
      <<giveGift $giftnpc _id>>
    <</link>><br>
  <</for>>
<<else>>
  <span style="color:grey;">持有物中没有可以赠送的物品，还是下次再来吧。</span>
<</if>>
<br><br>
[[返回|$playerPos.block]]


:: showNpcContent [widget nobr] {"position":"1275,1150","size":"100,100"}
<<widget "showNpcContent">>

/* 0. 取数据 */
<<silently>>
	/* 这些都写成 $ 变量，确保作用域正确 */
	<<set $todayMin to ($time.totalMinutes % 1440)>>
	<<set $layerNow to $playerPos.layer>>
	<<set $blockNow to $playerPos.block>>

/* 找今天能碰到的 NPC，允许同一地点同时出现在多个 NPC */
	<<set $currentNpcList to ($npcSchedule || []).filter(s => 
	Number(s.layer) == Number($playerPos.layer) &&
	String(s.block).trim() == String($playerPos.block).trim() &&
	((s.repeatDaily ? $todayMin : $time.totalMinutes) >= s.start) &&
	((s.repeatDaily ? $todayMin : $time.totalMinutes) <= s.end)
	)>>
	<<set $currentNpc to ($currentNpcList && $currentNpcList.length > 0 ? $currentNpcList[0] : null)>>

<</silently>>

/* 1. 有 NPC 就输出各自的对话 + 选项 */
<<if $currentNpcList && $currentNpcList.length > 0>>
	<<for _npcIndex, _npc range $currentNpcList>>
		<<if _npc && _npc.text>>
			<<= _npc.text + '<br><br>'>>
		<</if>>

		<<for _i, _opt range (_npc && _npc.options ? _npc.options : [])>>
			<<silently>>
				<<set _text to _opt[0]>>
				<<set _target to _opt[1]>>
				<<set _condition to (_opt.length > 2 ? _opt[2] : null)>>
				<<set _canShow to true>>

				/* 条件判断 */
				<<if _condition>>
					<<if _condition.match(/^\$\w+$/)>>
						<<set _varName to _condition.slice(1)>>
						<<if State.variables.hasOwnProperty(_varName)>>
							<<set _canShow to State.variables[_varName]>>
						<</if>>
					<<else>>
						<<set _expr to _condition.replace(/^\$\{|\}$/g,'')>>
						<<try>>
							<<set _canShow to Scripting.eval(_expr)>>
						<<catch _err>>
							<<set _canShow to false>>
						<</try>>
					<</if>>
				<</if>>
			<</silently>>

			<<if _canShow>>
				<<link _text _target>>
				<</link>>
				<<print " ">>
			<</if>>
		<</for>>

		<<if _npcIndex < $currentNpcList.length - 1>>
			<br><br>
		<</if>>
	<</for>>
<<else>>
	领班看上去不在这里。
<</if>>
<</widget>>



:: showtimewidget [widget nobr] {"position":"825,850","size":"100,100"}
<<widget "showTime">>
<<silently>>
    /* 1. 保底初始化 */
    <<if !$time>>
        <<set $time to {
            day: 1,
            hour: 8,
            minute: 0,
            totalMinutes: 8 * 60
        }>>
    <</if>>

    /* 2. 补零 */
    <<set _pad to (n) => (n < 10 ? '0' + n : n)>>

    /* 3. 拼装字符串 */
    <<if $time.minute% 1 !== 0>>
       <<set $time.minute to Math.floor($time.minute)>>
    <</if>>
    <<set _str to `Day ${$time.day}  ${$time.hour}:${_pad($time.minute)}`>>
<</silently>>
/* 4. 一次性输出 —— 用 <<= >> 或 <<print>> 都行 */
<<= _str>>
<</widget>>


:: giftwidget [widget] {"position":"4775,1075","size":"100,100"}
<<widget "giveGift">>
  <<set _npc  = $args[0]>>
  <<set _item = $args[1]>>

  <<if !_npc || !_item>><<return>><</if>>
  <<if !$inventory || !$inventory[_item] || $inventory[_item] <= 0>>
    你没有这个物品，无法赠送。
    <<return>>
  <</if>>

  <<set _def = $giftDB[_item]>>
  <<if !_def>>
    这个物品真的适合送人吗？还是再看看吧。
    <<return>>
  <</if>>

  <<set _rules = $npcGiftRules && $npcGiftRules[_npc] ? $npcGiftRules[_npc] : null>>

  /* --- A) 先判断是否拒收（拒收：不扣库存、不加好感） --- */
  <<set _reject = false>>
  <<if _rules>>
    <<if _rules.rejectItems && _rules.rejectItems.includes(_item)>>
      <<set _reject = true>>
    <</if>>
  <</if>>

  <<if _reject>>
    <<set _rejLine = (_rules.rejectItemDialog && _rules.rejectItemDialog[_item]) ? _rules.rejectItemDialog[_item] : "“对不起，我不太能接受这个。”">>
    <<print _rejLine>><br>
    <<print _npc>> 拒绝了你的礼物。
    <<return>>
  <</if>>

  /* --- B) 记录首次/非首次（按 tag 或 item） --- */
  <<set $giftHistory[_npc] = $giftHistory[_npc] ?? {items:{}, tags:{}}>>
  <<set _his = $giftHistory[_npc]>>

  /* 这里选择“用文化tag做芯片书类” */
  <<set _tags = _def.tags ?? []>>
  <<set _keyTag = _tags.includes("文化") ? "文化" : null>>

  <<set _isFirstTag = false>>
  <<if _keyTag>>
    <<if !_his.tags[_keyTag]>>
      <<set _isFirstTag = true>>
    <</if>>
  <</if>>

  /* --- C) 接受：扣库存 --- */
  <<set $inventory[_item] -= 1>>
  <<if $inventory[_item] <= 0>><<unset $inventory[_item]>><</if>>

  /* --- D) 计算好感增量（你可继续用你原本那套） --- */
  <<set _delta = _def.value ?? 1>>
  <<set $npcFavor[_npc] = ($npcFavor[_npc] ?? 0) + _delta>>

  /* --- E) 输出对话（首次/非首次） --- */
  <<if _keyTag && _rules>>
    <<if _isFirstTag && _rules.firstTagDialog && _rules.firstTagDialog[_keyTag]>>
      <<for _line range _rules.firstTagDialog[_keyTag]>>
        <<print _line>><br>
      <</for>>
    <<elseif !_isFirstTag && _rules.repeatTagDialog && _rules.repeatTagDialog[_keyTag]>>
      <<for _line range _rules.repeatTagDialog[_keyTag]>>
        <<print _line>><br>
      <</for>>
    <<else>>
      <<print "“谢谢你，$playerName。”">><br>
    <</if>>
  <<else>>
    你把「<<print _def.name>>」递给了 <<print _npc>>。<br>
  <</if>>

  ++<<print _npc>>的好感（+<<print _delta>>）
<em>_npc和你更熟悉了。</em>
<<set $npc to $npc ?? {}>>
<<set $npc[_npc] to $npc[_npc] ?? {}>>
<<set $npc[_npc].like to ($npc[_npc].like ?? 0) + _delta>>


  /* --- F) 更新历史与日志 --- */
  <<set _his.items[_item] = (_his.items[_item] ?? 0) + 1>>
  <<for _t range _tags>>
    <<set _his.tags[_t] = (_his.tags[_t] ?? 0) + 1>>
  <</for>>

  <<set $giftLog.push({npc:_npc,item:_item,itemName:_def.name,delta:_delta})>>
<</widget>>







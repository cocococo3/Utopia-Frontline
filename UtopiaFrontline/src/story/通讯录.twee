:: ContactsUI [nobr]{"position":"625,1075","size":"100,100"}
<div id="contacts-wrapper">
  <div class="contacts-head">
    <span>通讯录</span>
    <span class="close" onclick="Dialog.close()">✕</span>
  </div>

  <div id="contacts-list-view">
    <div id="contacts-list"></div>
  </div>

  <div id="contacts-chat-view" style="display:none;">
    <div class="chat-head">
      <span class="back" onclick="window.contactsChatBack()">← 返回</span>
      <img id="chat-avatar" class="chat-avatar">
      <span id="chat-name" class="chat-name"></span>
    </div>
    <div id="chat-messages"></div>
    <div id="chat-choices"></div>
  </div>

</div>
<<run setTimeout(function(){ window.contactsRender(); }, 10)>>


:: ContactsWidgets [widget nobr]
<<widget "contactsAdd">>
  <<silently>>
    <<set _k    to $args[0]>>
    <<set _name to $args[1] ?? "Unknown">>

    /* tags：允许传数组，也允许传 "a|b|c" 字符串 */
    <<set _tagsArg to $args[2] ?? "">>
    <<set _tags to []>>
    <<if Array.isArray(_tagsArg)>>
      <<set _tags to _tagsArg>>
    <<elseif typeof _tagsArg is "string" && _tagsArg.trim() != "">>
      <<set _tags to _tagsArg.split("|")>>
    <</if>>

    <<set _note to $args[3] ?? "" >>
    <<set _tel  to $args[4] ?? "" >>
    <<set _avt  to $args[5] ?? "" >>

    /* 可选：第6参 met，默认 true（即 add 就算相遇） */
    <<set _met to ($args.length >= 7) ? $args[6] : true>>

    /* 可选：第7参手动指定 addedAt（用于排序），不传则记录当前 State.turns，
       即"第几个回合被加入通讯录"，排序按这个来判断新旧 */
    <<set _addedAt to ($args.length >= 8) ? $args[7] : State.turns>>

    <<set $contacts to $contacts ?? {}>>
    <<if !$contacts[_k]>>
      <<set $contacts[_k] to {}>>
    <</if>>

    <<set $contacts[_k].name to _name>>
    <<set $contacts[_k].tags to _tags>>
    <<set $contacts[_k].note to _note>>
    <<set $contacts[_k].tel  to _tel>>
    <<set $contacts[_k].met  to _met>>

    <<if typeof $contacts[_k].addedAt !== "number">>
      <<set $contacts[_k].addedAt to _addedAt>>
    <</if>>

    <<if _avt != "">>
      <<set $contacts[_k].avatar to _avt>>
    <</if>>
  <</silently>>
<</widget>>


:: ContactsData [script]
/*  ********** 通讯录 API ********** */
window.contactsAPI = {
  // 新增/覆盖
  add: function(id, obj) {
    State.variables.contacts = State.variables.contacts || {};
    obj = obj || {};
    // 记录加入时间（State.turns），供"新→旧/旧→新"排序使用
    if (typeof obj.addedAt !== "number") {
      obj.addedAt = State.turns;
    }
    State.variables.contacts[id] = obj;
  },
  // 删除
  del: function(id) {
    if (State.variables.contacts) delete State.variables.contacts[id];
  },
  // 修改单个字段
  patch: function(id, key, val) {
    if (State.variables.contacts && State.variables.contacts[id])
      State.variables.contacts[id][key] = val;
  }
};
/*  ********** 默认初始几条 ********** */
setup.ContactsInit = function() {

  contactsAPI.add("lodia", {
    name  : "Lodia-洛迪娅",
    /*avatar: "https://i.imgur.com/xxx.png",   // 可本地 base64*/
    tags  : ["洗衣部","领班"],
    note  : "Lodia视你为需要照顾的新人。",
    
  });
  contactsAPI.add("carmel", {
    name  : "Carmel-卡梅尔",
   /* avatar: "https://i.imgur.com/yyy.png",*/
    tags  : ["维修部","领班"],
    note  : "Carmel对你尚存疑虑。",

  });
   contactsAPI.add("pep", {
    name  : "Pep-佩普",
   /* avatar: "https://i.imgur.com/yyy.png",*/
    tags  : ["巡逻队","机动领班"],
    note  : "Pep视你为需要照顾的新人。",
  });
    contactsAPI.add("corrina", {
    name  : "Corrina-科琳娜",
   /* avatar: "https://i.imgur.com/yyy.png",*/
    tags  : ["长官？"],
    note  : "Corrina视你如同其他人形。",
  });
  /* 想再塞默认值就继续 add … */
};
/* 首次运行时自动初始化 */
if (!State.variables.contacts) setup.ContactsInit();


:: ContactsChatData [script]
/* ============ 模拟聊天：对话脚本数据 ============

   每个 NPC 的聊天是一棵简单的节点树：

   setup.ChatScript["某NPC的key"] = {
     start: "起始节点id",
     nodes: {
       节点id: {
         npc: "NPC说的话"  // 也可以写成数组 ["第一句","第二句"]，会连续显示多个气泡
         choices: [
           {
             label:  "玩家选项文字（会作为一条气泡显示在右侧）",
             next:   "下一个节点id",   // 不填 / null 表示对话到此结束
             effect: function () {
               // 可选：这里就是"相关的事件功能"的挂载点
               // 例如改好感度：
               State.variables.npc.somebody.like += 3;
               // 设置剧情开关：
               // State.variables.flags.someFlag = true;
               // 甚至可以在满足条件时跳出聊天面板，进入一段完整的剧情 passage：
               // if (State.variables.npc.somebody.like >= 80) {
               //   Dialog.close();
               //   Engine.play("somebody_special_event");
               // }
             }
           }
         ]
       }
     }
   };

   没有在这里配置 ChatScript 的 NPC，点击"对话"仍会按旧逻辑跳转到 <key>_chat passage，
   方便你按角色逐个迁移到新的聊天面板，不用一次性重写所有内容。
*/

setup.ChatScript = setup.ChatScript || {};

setup.ChatScript.lodia = {
  start: "greet",
  triggers: [
    {
      node: "urgent",
      once: "lodia_urgent_1",
      when: function () {
        return !!(State.variables.flags && State.variables.flags.lodia_help_asked);
      }
    }
  ],
  nodes: {
    greet: {
      npc: ["哎……现在是什么时候来着……", "总之今天好，$playerName。"],
      choices: [
        {
          label: "只是想打个招呼。",
          next: "smalltalk",
          once:true,
          effect: function () {
           State.variables.npc.lodia.like += 1;
          }
        }
      ]
    },
    urgent: {
      npc: ["你还在忙吧？我有点事想跟你说。", "如果你愿意，稍后和我聊聊吧。"],
      choices: [
        { label: "好，听你说。", next: "smalltalk" },
        { label: "（结束对话）", next: null }
      ]
    },
    smalltalk: {
      npc: "哎呀，你真可爱^^",
      choices: [
        { label: "（结束对话）", next: null }
      ]
    }
  }
};

setup.ChatScript.corrina = {
  start: "greet",
  triggers: [
    {
      node: "followup",
      once: "corrina_followup_1",
      when: function () {
        return !!(State.variables.npc && State.variables.npc.corrina && State.variables.npc.corrina.like >= 60);
      }
    }
  ],
  nodes: {
    greet: {
      npc: ["嗯？有事吗？"],
      choices: [
        { label: "我想了解这片区域的事。", next: "followup", once: true }
      ]
    },
    followup: {
      npc: ["你若愿意听，我可以告诉你一些值得注意的东西。", "但先得看你有没有准备好承担后果。"],
      choices: [
        { label: "（结束对话）", next: null }
      ]
    }
  }
};


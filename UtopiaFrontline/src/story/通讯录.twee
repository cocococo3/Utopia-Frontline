:: ContactsScript [script]
/* ============ 通讯录（$contacts + $npc 合并渲染，支持排序 + 模拟聊天） ============ */

window.contactsRender = function (list, sortModeArg) {
  var box = document.getElementById('contacts-list');
  if (!box) return;

  var contacts = State.variables.contacts || {}; // <<contactsAdd>> 写入这里
  var npcTbl   = State.variables.npc || {};      // 好感度/area/相遇等在这里

  /* 排序模式：new = 新→旧，old = 旧→新，az = 字母顺序。记忆在 $_contactsSort 里 */
  var sortMode = sortModeArg || State.variables._contactsSort || 'new';
  State.variables._contactsSort = sortMode;

  var keys = list ? Object.keys(list) : Object.keys(contacts);

  keys.sort(function (ka, kb) {
    var ca = (list ? list[ka] : contacts[ka]) || {};
    var cb = (list ? list[kb] : contacts[kb]) || {};
    var na = ca.name || (npcTbl[ka] && npcTbl[ka].name) || ka;
    var nb = cb.name || (npcTbl[kb] && npcTbl[kb].name) || kb;

    if (sortMode === 'az') {
      return na.localeCompare(nb, 'zh-Hans-CN');
    }

    var ta = (typeof ca.addedAt === 'number') ? ca.addedAt : 0;
    var tb = (typeof cb.addedAt === 'number') ? cb.addedAt : 0;

    if (ta === tb) return na.localeCompare(nb, 'zh-Hans-CN');
    return (sortMode === 'old') ? (ta - tb) : (tb - ta);
  });

  var html = '';

  keys.forEach(function (k) {
    var c = (list ? list[k] : contacts[k]) || {};
    var n = npcTbl[k] || {};

    var met = (c.met !== false);

    var like = (typeof n.like === 'number') ? n.like : 0;

    var likeColor = '';
    if (like >= 75) likeColor = 'color:#ff5050; font-weight:bold;';
    else if (like >= 50) likeColor = 'color:#4fa3ff;';
    else likeColor = 'color:#aaa;';

    var fallbackKnown   = 'https://i.imgur.com/8A4f0kF.png';
    var fallbackUnknown = 'https://i.imgur.com/vN7jIpe.png';

    var avatarKnown = c.avatar || n.avatar_known || fallbackKnown;
    var avatarUnk   = n.avatar_unknown || fallbackUnknown;
    var avatar = met ? avatarKnown : avatarUnk;

    var showName = c.name || n.name || k;

    var tags = Array.isArray(c.tags) ? c.tags : [];
    var note = c.note || '';
    var tel  = c.tel || '';

    var btnHTML = '';
    if (!met) {
      btnHTML = '<button disabled title="尚未相遇">？？？</button>';
    } else if (like > 30) {
      btnHTML = '<button class="talk-btn" onclick="window.contactsChatOpen(\'' + k + '\')">对话</button>';
    } else {
      btnHTML = '<button disabled title="好感度不足（需>30）">对话</button>';
    }

    var profileTriggerAttr = met
      ? ' onclick="window.contactsOpenProfile(\'' + k + '\')" title="查看角色资料"'
      : '';

    // ↓↓↓ 唯一改动的部分：更紧凑的行式卡片结构 ↓↓↓
    html +=
      '<div class="contact-card" data-key="' + k + '">' +
        '<div class="cc-main"' + profileTriggerAttr + '>' +
          '<img class="cc-avatar" src="' + avatar + '">' +
          '<div class="cc-info">' +
            '<div class="cc-row1">' +
              '<span class="cc-name">' + (met ? showName : "？？？") + '</span>' +
              '<span class="cc-like" style="' + likeColor + '">❤ ' + like + '</span>' +
            '</div>' +
            (tags.length
              ? '<div class="cc-tags">' + tags.map(function (t) {
                  return '<span class="cc-tag">' + t + '</span>';
                }).join('') + '</div>'
              : '') +
            /*(met && note ? '<div class="note">' + note + '</div>' : '') +
            (met && tel  ? '<div class="tel">'  + tel  + '</div>' : '') +*/
          '</div>' +
        '</div>' +
        '<div class="cc-actions">' + btnHTML + '</div>' +
      '</div>';
    // ↑↑↑ 唯一改动的部分 ↑↑↑
  });

  box.innerHTML = html || '<div class="contacts-empty">暂无联系人</div>';

  var sortBox = document.getElementById('contacts-sort');
  if (sortBox) {
    Array.prototype.forEach.call(sortBox.querySelectorAll('button'), function (btn) {
      if (btn.dataset.sort === sortMode) btn.classList.add('active');
      else btn.classList.remove('active');
    });
  }
};

window.contactsSetSort = function (mode) {
  window.contactsRender(null, mode);
};


/* ============ 模拟聊天面板（未改动，与原版一致） ============ */

window.contactsResolveText = function (text) {
  if (text === null || text === undefined) return '';
  if (typeof text !== 'string') return String(text);

  var resolved = text;
  var vars = resolved.match(/\$[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*|\[[^\]]+\])*/g) || [];

  vars.forEach(function (token) {
    var expr = token.slice(1).replace(/\[(.*?)\]/g, '.$1');
    var segments = expr.split('.').filter(function (seg) { return seg !== ''; });
    var current = State.variables;
    var found = true;

    for (var i = 0; i < segments.length; i++) {
      if (current === null || current === undefined || !(segments[i] in current)) {
        found = false;
        break;
      }
      current = current[segments[i]];
    }

    var value = found ? current : '';
    resolved = resolved.split(token).join(String(value));
  });

  return resolved;
};

window.contactsChatPushNpcLines = function (key, npcText) {
  if (!npcText) return;
  var lines = Array.isArray(npcText) ? npcText : [npcText];
  lines.forEach(function (t) {
    State.variables.chatLog[key].push({ who: 'npc', text: window.contactsResolveText(t) });
  });
};

window.contactsChatRenderMessages = function (key) {
  var log = State.variables.chatLog[key] || [];
  var box = document.getElementById('chat-messages');
  if (!box) return;
  var html = '';
  log.forEach(function (m) {
    var cls = (m.who === 'me') ? 'bubble-me' : 'bubble-npc';
    html += '<div class="chat-bubble ' + cls + '">' + m.text + '</div>';
  });
  box.innerHTML = html;
  box.scrollTop = box.scrollHeight;
};

window.contactsChatRenderChoices = function (key) {
  var script = (setup.ChatScript && setup.ChatScript[key]) || null;
  var nodeId = State.variables.chatNode[key];
  var box = document.getElementById('chat-choices');
  if (!box) return;

  if (!script || !nodeId || !script.nodes[nodeId]) {
    box.innerHTML = '<div class="chat-end">（暂时没有更多话题）</div>';
    return;
  }

  var node = script.nodes[nodeId];
  var choices = node.choices || [];
  var used = (State.variables.chatUsed && State.variables.chatUsed[key]) || {};

  // 过滤掉已完成过的"一次性"选项，同时保留原始 idx（onclick 要用原始下标）
  var visible = [];
  choices.forEach(function (ch, idx) {
    var cid = ch.id || (nodeId + '#' + idx);
    if (ch.once && used[cid]) return;
    visible.push({ ch: ch, idx: idx });
  });

  if (visible.length === 0) {
    box.innerHTML = '<div class="chat-end">（对话已结束）</div>';
    return;
  }

  var html = '';
  visible.forEach(function (v) {
    html += '<button class="chat-choice-btn" onclick="window.contactsChatChoose(\'' + key + '\',' + v.idx + ')">' + window.contactsResolveText(v.ch.label) + '</button>';
  });
  box.innerHTML = html;
};

window.contactsChatApplyNpcTrigger = function (key, script) {
  var nextNode = null;
  if (!script || !script.nodes) return nextNode;

  var chatUsedTrigger = State.variables.chatUsedTrigger = State.variables.chatUsedTrigger || {};
  var usedForKey = chatUsedTrigger[key] = chatUsedTrigger[key] || {};

  var triggers = Array.isArray(script.triggers) ? script.triggers : [];
  for (var i = 0; i < triggers.length; i++) {
    var trigger = triggers[i];
    if (!trigger || !trigger.node || !script.nodes[trigger.node]) continue;
    if (trigger.once && usedForKey[trigger.once]) continue;

    var check = trigger.when || trigger.condition || trigger.check;
    if (typeof check === 'function' && check.call(null, key, script, State.variables)) {
      if (trigger.once) usedForKey[trigger.once] = true;
      nextNode = trigger.node;
      break;
    }
  }

  if (!nextNode) {
    Object.keys(script.nodes).forEach(function (nodeId) {
      if (nextNode) return;
      var node = script.nodes[nodeId];
      if (!node || !node.trigger) return;
      var trigger = node.trigger;
      if (trigger.once && usedForKey[trigger.once]) return;
      var check = trigger.when || trigger.condition || trigger.check;
      if (typeof check === 'function' && check.call(null, key, script, State.variables)) {
        if (trigger.once) usedForKey[trigger.once] = true;
        nextNode = nodeId;
      }
    });
  }

  return nextNode;
};

window.contactsChatTrigger = function (key, nodeId, opts) {
  var script = (setup.ChatScript && setup.ChatScript[key]) || null;
  if (!script || !script.nodes || !script.nodes[nodeId]) return false;

  opts = opts || {};
  State.variables.chatLog = State.variables.chatLog || {};
  State.variables.chatNode = State.variables.chatNode || {};
  State.variables.chatUsedTrigger = State.variables.chatUsedTrigger || {};

  if (opts.once) {
    State.variables.chatUsedTrigger[key] = State.variables.chatUsedTrigger[key] || {};
    if (State.variables.chatUsedTrigger[key][opts.once]) return false;
    State.variables.chatUsedTrigger[key][opts.once] = true;
  }

  State.variables._activeChatKey = key;
  State.variables.chatLog[key] = State.variables.chatLog[key] || [];
  State.variables.chatNode[key] = nodeId;
  window.contactsChatPushNpcLines(key, script.nodes[nodeId].npc);

  var listView = document.getElementById('contacts-list-view');
  var chatView = document.getElementById('contacts-chat-view');
  if (listView) listView.style.display = 'none';
  if (chatView) chatView.style.display = 'flex';

  var contacts = State.variables.contacts || {};
  var npcTbl = State.variables.npc || {};
  var c = contacts[key] || {};
  var n = npcTbl[key] || {};
  var avatarEl = document.getElementById('chat-avatar');
  var nameEl = document.getElementById('chat-name');
  if (avatarEl) avatarEl.src = c.avatar || n.avatar_known || '';
  if (nameEl) nameEl.textContent = c.name || n.name || key;

  window.contactsChatRenderMessages(key);
  window.contactsChatRenderChoices(key);
  return true;
};

window.contactsEnsureChatScript = function (key) {
  if (!setup.ChatScript) setup.ChatScript = {};
  if (!setup.ChatScript[key]) {
    setup.ChatScript[key] = {
      start: 'greet',
      nodes: {
        greet: {
          npc: ['你有事想找我吗？'],
          choices: [
            { label: '我想了解一下情况。', next: 'info', once: true },
            { label: '（结束对话）', next: null }
          ]
        },
        info: {
          npc: ['我现在不方便说太多，但你可以继续和我相处，了解更多。'],
          choices: [
            { label: '（结束对话）', next: null }
          ]
        }
      }
    };
  }
  return setup.ChatScript[key];
};

window.contactsChatOpen = function (key) {
  var contacts = State.variables.contacts || {};
  var npcTbl   = State.variables.npc || {};
  var c = contacts[key] || {};
  var n = npcTbl[key] || {};

  var script = window.contactsEnsureChatScript(key);
  if (!script || !script.nodes) return;

  State.variables._activeChatKey = key;   // 记录当前聊天对象

  State.variables.chatLog  = State.variables.chatLog  || {};
  State.variables.chatNode = State.variables.chatNode || {};

  if (!State.variables.chatLog[key]) {
    State.variables.chatLog[key] = [];
  }

  if (!State.variables.chatNode[key]) {
    var triggeredNode = window.contactsChatApplyNpcTrigger(key, script);
    State.variables.chatNode[key] = triggeredNode || script.start;
    if (script.nodes && script.nodes[State.variables.chatNode[key]]) {
      window.contactsChatPushNpcLines(key, script.nodes[State.variables.chatNode[key]].npc);
    }
  }

  var listView = document.getElementById('contacts-list-view');
  var chatView = document.getElementById('contacts-chat-view');
  if (listView) listView.style.display = 'none';
  if (chatView) chatView.style.display = 'flex';

  var avatarEl = document.getElementById('chat-avatar');
  var nameEl   = document.getElementById('chat-name');
  if (avatarEl) avatarEl.src = c.avatar || n.avatar_known || '';
  if (nameEl)   nameEl.textContent = c.name || n.name || key;

  window.contactsChatRenderMessages(key);
  window.contactsChatRenderChoices(key);
};   // ← 别忘了这个闭合

window.contactsChatChoose = function (key, idx) {
  var script = (setup.ChatScript && setup.ChatScript[key]) || null;
  if (!script) return;

  var nodeId = State.variables.chatNode[key];
  var node = script.nodes[nodeId];
  if (!node || !node.choices || !node.choices[idx]) return;

  var choice = node.choices[idx];

  // ↓↓↓ 新增：标记一次性选项为已完成 ↓↓↓
  if (choice.once) {
    State.variables.chatUsed = State.variables.chatUsed || {};
    State.variables.chatUsed[key] = State.variables.chatUsed[key] || {};
    var cid = choice.id || (nodeId + '#' + idx);
    State.variables.chatUsed[key][cid] = true;
  }
  // ↑↑↑ 新增结束 ↑↑↑

  State.variables.chatLog[key].push({ who: 'me', text: window.contactsResolveText(choice.label) });

  if (typeof choice.effect === 'function') {
    choice.effect();
  }

  var nextId = choice.next || null;
  State.variables.chatNode[key] = nextId;

  if (nextId && script.nodes[nextId]) {
    window.contactsChatPushNpcLines(key, script.nodes[nextId].npc);
  }

  window.contactsChatRenderMessages(key);
  window.contactsChatRenderChoices(key);
};

window.contactsChatReset = function (key) {
  if (State.variables.chatLog)   delete State.variables.chatLog[key];
  if (State.variables.chatNode)  delete State.variables.chatNode[key];
  if (State.variables.chatUsed)  delete State.variables.chatUsed[key]; // 新增
  if (State.variables.chatUsedTrigger) delete State.variables.chatUsedTrigger[key];
};

window.contactsChatBack = function () {
  var key = State.variables._activeChatKey;
  if (key) {
    window.contactsChatReset(key);        // ★ 新增：清空聊天状态
    State.variables._activeChatKey = null;
  }

  var listView = document.getElementById('contacts-list-view');
  var chatView = document.getElementById('contacts-chat-view');
  if (chatView) chatView.style.display = 'none';
  if (listView) listView.style.display = 'block';
  window.contactsRender();
};


/* ============ 角色介绍页（未改动） ============ */
window.contactsOpenProfile = function (key) {
  State.variables.activeNPC = key;
  Dialog.close();
  Engine.play('NPCProfile');
};

window.npcProfileImage = function (key) {
  var c = (State.variables.contacts && State.variables.contacts[key]) || {};
  var n = (State.variables.npc && State.variables.npc[key]) || {};
  return c.portrait || c.avatar || n.avatar_known || '';
};

window.npcFlagsAllTrue = function (flagNames) {
  var flags = State.variables.flags || {};
  return flagNames.every(function (f) { return !!flags[f]; });
};


/* 自动渲染"通讯录"Passage */
$(document).on(':passagerender', function (ev) {
  if (ev.passage && ev.passage.title === '通讯录') {
    setTimeout(function () { window.contactsRender(); }, 10);
  }
});

predisplay["Menu Return"] = function (taskName) {
	if (! tags().includes("noreturn")) {
		State.variables.return = passage();
	}
};

function randomItemsFromArray(arr, count) {
    let result = [];
    for (let i = 0; i < count; i++) {
        let randomIndex = Math.floor(Math.random() * arr.length);
        result.push(arr[randomIndex]);
    }
    return result;
}




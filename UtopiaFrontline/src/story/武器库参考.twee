:: 武器存放处[nobr]
<<syncEquippedWeapon>>
<<set _focusWeaponId = $lastViewedWeaponId || "">>
<<set _focusWeapon = _focusWeaponId && window.getWeaponRef ? window.getWeaponRef(_focusWeaponId) : null>>
<<set _focusOwned = _focusWeaponId && $weaponList && $weaponList.find(w => w.id === _focusWeaponId) != null>>
<div class="weapon-storage">
  <div class="neon-title">⚔ 武器存放处 ⚔</div>

  <<if _focusWeapon>>
    <div class="reference-panel">
      <div class="reference-title">参考：<<= _focusWeapon.name>></div>
      <div class="reference-meta">
        <span>伤：<<= _focusWeapon.damageBonus>></span>
        <span>耐：<<= _focusWeapon.wearReduction>></span>
        <<if _focusWeapon.basePrice>><span>售价：<<= _focusWeapon.basePrice>> 公分</span><</if>>
      </div>
      <div class="reference-body">
        <<if _focusOwned>>
          你已经持有这件武器，详情在下方列表可直接装备或存放。
        <<else>>
          这件武器可在锻造部购买，并且会同步显示在这里的库中总览。
        <</if>>
        <br>
        <<if _focusWeapon.desc>>» <<= _focusWeapon.desc>> «<</if>>
      </div>
    </div>
  <</if>>
  
  <div class="slot-info">
    当前武器位上限：<span class="unlocked"><<= $maxWeaponSlots>></span> / 9
    <br>
    持有武器数：<<= $weaponList.length>> / <<= $maxWeaponSlots + 10>>
    <br>
    <<for _s = 1; _s <= 9; _s++>>
      <<if _s <= $maxWeaponSlots>>
        <span class="unlocked">[位<<= _s>>: <<= $weaponSlots[_s] ? $weaponList.find(w => w.id === $weaponSlots[_s])?.name ?? "空" : "空">>]</span>
      <<else>>
        <span class="locked">[位<<= _s>> 锁定]</span>
      <</if>>
      <<= _s < 9 ? " " : "">>
    <</for>>
  </div>

  <div class="store-link-row">
    [[前往武器商店|购买武器]]
  </div>

  <<if $weaponList.length === 0>>
    <div class="empty-notice">
      武器柜空空如也……你还没有趁手的武器<br>
      <span style="font-size:0.9em">去锻造部看看有没有武器可以售卖吧。</span>
    </div>
  <<else>>
    <<for _i = 0; _i < $weaponList.length; _i++>>
      <<set _weapon = $weaponList[_i]>>
      <div class="weapon-entry">
        <div class="weapon-header">
          <span class="weapon-name"><<= _weapon.name>></span>
          <span style="color:#666; font-size:0.8em">ID: <<= _weapon.id>></span>
        </div>
        
        <span class="weapon-stat">额外造伤：<<= _weapon.damageBonus>></span>
        <span class="weapon-stat">磨损减少：<<= _weapon.wearReduction>></span>
        <br>
        
        <div class="weapon-desc">» <<= _weapon.desc>> «</div>
        
        <div class="weapon-actions">
          <<link "装备">>
            <<equipWeaponById _weapon.id>>
            <<goto "武器存放处">>
          <</link>>
          
          <<for _slot = 1; _slot <= $maxWeaponSlots; _slot++>>
            <<capture _slot _weapon>>
              [[存放至<<= _slot>>号位|武器存放处][$weaponSlots[_slot] = _weapon.id]]
            <</capture>>
          <</for>>
          
          <<if $maxWeaponSlots < 9>>
            <<for _slot = $maxWeaponSlots + 1; _slot <= 9; _slot++>>
              <span class="slot-locked"><<= _slot>>号位(锁定)</span>
            <</for>>
          <</if>>
          
          /* 删除按钮 */
          <<if $deleteConfirmId === _weapon.id>>
            <span class="delete-warning">
              ⚠ 确定要销毁「<<= _weapon.name>>」吗？此操作不可撤销！
             <<link "确认销毁" "武器存放处">><<deleteWeapon _i>><</link>>
              [[取消|武器存放处][$deleteConfirmId = ""]]
            </span>
          <<else>>
            [[销毁|武器存放处][$deleteConfirmId = _weapon.id]]
          <</if>>
        </div>
      </div>
      
      <<if _i < $weaponList.length - 1>>
        <div class="separator">——————</div>
      <</if>>
    <</for>>
  <</if>>
[[增加武器位]]
  <div class="back-btn">
    <<link "返回">>
      <<set $deleteConfirmId = "">>
      <<goto $playerPos.block>>
    <</link>>
  </div>
</div>


:: getWeaponById [widget nobr]
<<widget "syncEquippedWeapon">>
  <<set _equippedId = $equippedWeapon || "">>
  <<set _eqWeapon = null>>
  <<if _equippedId && $weaponList>>
    <<for _i = 0; _i < $weaponList.length; _i++>>
      <<if $weaponList[_i].id === _equippedId>>
        <<set _eqWeapon = $weaponList[_i]>>
        <<break>>
      <</if>>
    <</for>>
  <</if>>
  <<if _eqWeapon>>
    <<set $player.weapon to {
      id: _eqWeapon.id,
      name: _eqWeapon.name,
      damageBonus: Number(_eqWeapon.damageBonus) || 0,
      wearReduction: Number(_eqWeapon.wearReduction) || 0,
      desc: _eqWeapon.desc || ""
    }>>
  <<else>>
    <<set $equippedWeapon to "">>
    <<set $player.weapon to {}>>
  <</if>>
<</widget>>

<<widget "equipWeaponById">>
  <<set $equippedWeapon to $args[0] || "">>
  <<syncEquippedWeapon>>
<</widget>>

<<widget "getWeaponById">>
  <<set _w = $weaponList.find(w => w.id === $args[0])>>
  <<if _w>>
    <<= _w[$args[1]] ?? "">>
  <<else>>
    未知武器
  <</if>>
<</widget>>

/* 使用方式 
<<getWeaponById $weaponSlots[1] "name">>*/

:: 增加武器位
<<if $maxWeaponSlots <= 3>>
    你目前有$maxWeaponSlots个武器位，需要消耗50公分开启一个新的武器位吗？
    <<link "好的">><<if $money>=50>><<set $maxWeaponSlots+=1>>
        <<set $money-=50>>
        <<goto "武器存放处">>
        <<else>>
            <<goto "增加武器位失败">>
    <</if>><</link>>
    [[算了|武器存放处]]
<<elseif $maxWeaponSlots<=4>>
    你目前有$maxWeaponSlots个武器位，需要消耗100公分开启一个新的武器位吗？
    <<link "好的">><<if $money>=100>><<set $maxWeaponSlots+=1>>
        <<set $money-=100>>
        <<goto "武器存放处">>
        <<else>>
            <<goto "增加武器位失败">>
    <</if>><</link>>
    [[算了|武器存放处]]
<<elseif $maxWeaponSlots<=9>>
    你目前有$maxWeaponSlots个武器位，需要消耗200公分开启一个新的武器位吗？
    <<link "好的">><<if $money>=200>>
        <<set $money-=200>><<set $maxWeaponSlots+=1>>
        <<goto "武器存放处">>
        <<else>>
            <<goto "增加武器位失败">>
    <</if>><</link>>
    [[算了|武器存放处]]
<<else>>
    你的武器位数量已经达到上限，整理一下吧。

    [[好吧|武器存放处]]
<</if>>


:: 增加武器位失败
你目前持有的公分：$money

你的公分不足以增加新的武器位，努力工作吧！

[[好吧|武器存放处]]


:: 删除武器 [widget nobr]
<<widget "deleteWeapon">>
  <<set _delIndex = $args[0]>>
  <<set _delId = $weaponList[_delIndex].id>>
  
  /* 如果该武器正装备着，卸下 */
  <<if $equippedWeapon === _delId>>
    <<set $equippedWeapon = "">>
  <</if>>
  
  /* 清空所有存放该武器的槽位 */
  <<for _s = 1; _s <= 9; _s++>>
    <<if $weaponSlots[_s] === _delId>>
      <<set $weaponSlots[_s] = "">>
    <</if>>
  <</for>>
  
  /* 从列表删除 */
  <<set $weaponList.deleteAt(_delIndex)>>
  
  /* 重置确认状态 */
  <<set $deleteConfirmId = "">>
<</widget>>
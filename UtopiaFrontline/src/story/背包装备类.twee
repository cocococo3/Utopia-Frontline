:: 物品实例widget [widget nobr] {"position":"2500,8875","size":"100,100"}
/* uid 生成器：每个物品实例（哪怕同一种物品）都有唯一 uid，用来区分个体 */
<<widget "newUid">>
  <<set $uidSeed += 1>>
  <<set _uid to "it" + $uidSeed>>
<</widget>>

/* 按 shopDB 里的 id 生成 _qty 个物品实例，塞进 $inv */
<<widget "gainItem">>
  <<set _id  to $args[0]>>
  <<set _qty to Number($args[1] ?? 1)>>
  <<if !$shopDB || !$shopDB[_id]>><<initShopDB>><</if>>
  <<set _def to (($shopDB && $shopDB[_id]) || ($shopPool && $shopPool[_id]))>>

  <<if !_def>>
    <<run console.warn("gainItem: shopDB 不存在该 id:", _id)>>
    <<return>>
  <</if>>

  <<if _qty <= 0>>
    <<return>>
  <</if>>

  <<for _i = 0; _i < _qty; _i++>>
    <<newUid>>
    <<set _inst to {
      id:  _id,
      uid: _uid,
      dur: (_def.wear ?? null),
      name: _def.name,
      desc: _def.desc,
      icon: _def.icon ?? "📦"
    }>>
    <<run $inv.push(_inst)>>
  <</for>>
<</widget>>

/* 移除某个具体实例（不区分是否装备中，调用前请自行判断） */
<<widget "removeItemByUid">>
  <<set _uid to $args[0]>>
  <<findInvIndexByUid _uid>>
  <<if _idx >= 0>>
    <<set $inv.deleteAt(_idx)>>
  <</if>>
<</widget>>

/* 使用消耗品/工具：按 effect 生效。
   装备类（slot不为空）不走这里，请用 equip 系统穿戴。
   effect 处理完之后统一走耗损流程：
     wear为null -> 一次性消耗品，用一次就没
     wear为数字 -> 每用一次耐久-1，耐久归零才消失（camera/jointoil/repairtoolset等"多次可用"的道具走这条）
*/
<<widget "useItem">>
  <<set _uid to $args[0]>>
  <<findInvIndexByUid _uid>>
  <<if _idx < 0>>
    <<run console.warn("useItem: 找不到实例 uid:", _uid)>>
    <<return>>
  <</if>>

  <<set _inst to $inv[_idx]>>
  <<set _def  to $shopDB[_inst.id]>>
  <<if !_def>>
    <<return>>
  <</if>>

  /* 装备类物品不能直接"使用"，请去装备栏穿戴 */
  <<if _def.slot>>
    <<notify 1.5s>>这是装备类物品，请在装备栏中穿戴使用<</notify>>
    <<return>>
  <</if>>

  <<switch _def.effect>>
    <<case "protect">>
      <<set $protectionoilon to true>>
      <<set $protectionoilondate to $time.day>>
      <<notify 1.5s>>使用成功！现在你不被怪物的异常电波影响了！<</notify>>

    <<case "energy">>
      /* 提升电量上限（如应急充电包） */
     <<set $power+=25>>
      <<notify 1s>>电量提升了25点<</notify>>

    <<case "maintenance">>
      /* 降低日常磨损值（如关节油剂） */
      <<set $oilused to true>>
      <<notify 1s>>使用成功！在之后的24小时内，你的磨损度自然增长将会减半。<</notify>>

    <<case "repair">>
      /* 自我修复，需要维修技能达标才能生效；技能不够则不消耗物品 */
      <<if ($skillRepair ?? 0) > 0>>
        <<set $bodyDamage to Math.max(0, ($bodyDamage ?? 0) - _def.val)>>
        <<notify 1s>>成功修复了 <<= _def.val>> 点损伤<</notify>>
      <<else>>
        <<notify 1.5s>>你的维修技能不足，无法使用这件工具<</notify>>
        <<return>>
      <</if>>

    <<case "material">>
      /* 制作材料，不通过 useItem 直接消耗，交给制作系统处理 */
      <<notify 1.5s>>这是制作材料，请在制作界面中使用<</notify>>
      <<return>>

    <<case "photo">>
      /* 拍照留念，记录一条影像 */
      <<if !$photos>><<set $photos to []>><</if>>
      <<run $photos.push({time: ($time.totalMinutes ?? 0), from: _inst.id})>>
      <<notify 1s>>拍下了一张照片<</notify>>

    <<default>>
      <<run console.warn("useItem: 未处理的 effect 类型:", _def.effect)>>
      <<return>>
  <</switch>>

  /* 统一耗损流程 */
  <<if _def.wear === null || typeof _def.wear === "undefined">>
    <<set $inv.deleteAt(_idx)>>
  <<else>>
    <<set _inst.dur -= 1>>
    <<if _inst.dur <= 0>>
      <<set $inv.deleteAt(_idx)>>
    <<else>>
      <<set $inv[_idx] to _inst>>
    <</if>>
  <</if>>
<</widget>>

:: 消耗品列表widget [widget nobr]
<<widget "consumableList">>
  <div id="consumableBox">
    <<set _list to []>>
    <<for _i = 0; _i < $inv.length; _i++>>
      <<set _it to $inv[_i]>>
      <<set _d  to $shopDB[_it.id]>>
      <<if _d && !_d.slot && _d.effect !== "material">>
        <<run _list.push(_it)>>
      <</if>>
    <</for>>

    <<if _list.length is 0>>
      （背包里没有可使用的物品）
    <<else>>
      <<for _it range _list>>
        <<set _d to $shopDB[_it.id]>>
        <div>
          <<print (_d.icon ?? "📦") + " " + _d.name + ((_d.desc) ? "（" + _d.desc + "）" : "")>>
          <<if typeof _it.dur is "number">>（剩余<<print _it.dur>>次）<</if>>
          <<capture _it>>
            <<link "使用">>
              <<useItem _it.uid>>
              <<goto "角色总览">>
            <</link>>
          <</capture>>
        </div>
      <</for>>
    <</if>>
  </div>
<</widget>>

:: 装备背包物品widget [widget nobr] {"position":"1275,1700","size":"100,100"}

<<widget "findInvIndexByUid">>
  <<set _uid to $args[0]>>
  <<set _idx to -1>>
  <<for _i = 0; _i < $inv.length; _i++>>
    <<if $inv[_i].uid is _uid>>
      <<set _idx to _i>>
      <<break>>
    <</if>>
  <</for>>
<</widget>>

<<widget "unequip">>
  <<set _slot to $args[0]>>
  <<set $equip[_slot] to null>>
<</widget>>

<<widget "equip">>
  <<set _slot to $args[0]>>
  <<set _uid  to $args[1]>>

  <<findInvIndexByUid _uid>>
  <<if _idx < 0>>
    <<run console.warn("equip: 找不到实例 uid:", _uid)>>
    <<return>>
  <</if>>

  <<set _id  to $inv[_idx].id>>
  <<set _def to $shopDB[_id]>>

  <<if !_def || (_def.slot ?? "") !== _slot>>
    <<run console.warn("equip: slot 不匹配或模板不存在:", _id, _slot)>>
    <<return>>
  <</if>>

  <<set $equip[_slot] to _uid>>
<</widget>>

<<widget "damageEquipped">>
  <<set _slot to $args[0]>>
  <<set _amt  to $args[1] ?? 1>>

  <<set _uid to $equip[_slot]>>
  <<if !_uid>>
    <<set _damageResult to {ok:false, reason:"no_equip"}>>
    <<return>>
  <</if>>

  <<findInvIndexByUid _uid>>
  <<if _idx < 0>>
    <<set $equip[_slot] to null>>
    <<set _damageResult to {ok:false, reason:"equip_missing"}>>
    <<return>>
  <</if>>

  <<set _inst to $inv[_idx]>>
  <<if typeof _inst.dur !== "number">>
    <<set _damageResult to {ok:true, reason:"no_dur"}>>
    <<return>>
  <</if>>

  <<set _inst.dur -= _amt>>

  <<if _inst.dur <= 0>>
    <<if $equip[_slot] is _uid>>
      <<set $equip[_slot] to null>>
    <</if>>
    <<set $inv.deleteAt(_idx)>>
    <<set _damageResult to {ok:true, broken:true}>>
  <<else>>
    <<set $inv[_idx] to _inst>>
    <<set _damageResult to {ok:true, broken:false, dur:_inst.dur}>>
  <</if>>
<</widget>>

<<widget "wardrobeSlot">>
  <<set _slot  to $args[0]>>
  <<set _equippedUid to $equip[_slot] ?? null>>
  <<set _boxId to "wardrobeSlot_" + _slot>>

  <div id="<<= _boxId>>">
    <h3><<print _slot>> 槽位</h3>

    <<if _equippedUid>>
      <<findInvIndexByUid _equippedUid>>
      <<if _idx >= 0>>
        <<set _inst to $inv[_idx]>>
        <<set _def to $shopDB[_inst.id]>>
        正在使用：<<print (_def.icon ?? "📦") + " " + _def.name + ((_def.desc) ? "（" + _def.desc + "）" : "")>>
        <<if typeof _inst.dur is "number">>（耐久：<<print _inst.dur>>）<</if>>
        <<capture _slot _boxId>>
          <<link "卸下">>
            <<unequip _slot>>
            <<goto "衣柜">>
          <</link>>
        <</capture>>
      <<else>>
        （装备异常，已清空）
        <<set $equip[_slot] to null>>
      <</if>>
    <<else>>
      （未装备）
    <</if>>

    <hr>

    <<set _list to []>>
    <<for _i = 0; _i < $inv.length; _i++>>
      <<set _it to $inv[_i]>>
      <<set _d  to $shopDB[_it.id]>>
      <<if _d && (_d.slot ?? "") is _slot>>
        <<set _list.push(_it)>>
      <</if>>
    <</for>>

    <<if _list.length is 0>>
      （背包里没有可装备该槽位的物品）
    <<else>>
      <<for _it range _list>>
        <<set _d to $shopDB[_it.id]>>
        <div>
          <<print (_d.icon ?? "📦") + _d.name>>
          <<if typeof _it.dur is "number">>（耐久：<<print _it.dur>>）<</if>>
          <<if $equip[_slot] is _it.uid>>
            ✅已装备
          <<else>>
            <<capture _slot _it _boxId>>
              <<link "装备">>
                <<equip _slot _it.uid>>
                /* 局部刷新：只重画自己这个容器 */
                 <<goto "衣柜">>
              <</link>>
            <</capture>>
          <</if>>
        </div>
      <</for>>
    <</if>>
  </div>
<</widget>>




:: 商店widget [widget nobr] {"position":"2775,8925","size":"100,100"}
/* 单个商品卡片：展示 + 购买。每次点击购买固定买1件，调用 gainItem 生成带 uid 的实例 */
<<widget "shopItem">>
  <<set _id  to $args[0]>>
  <<set _def to $shopDB[_id]>>

  <<if !_def>>
    <<run console.warn("shopItem: shopDB 不存在该 id:", _id)>>
    <<return>>
  <</if>>

  <div class="shopCard">
    <span class="icon"><<= _def.icon ?? "📦">></span>
    <span class="name"><<= _def.name>></span>
    <<if _def.desc>>
      <span class="desc">（<<= _def.desc>>）</span>
    <</if>>
    <span class="price"><<= _def.price>> 工分</span>

    <<capture _id>>
      <<button "购买">>
        <<set _total to $shopDB[_id].price>>
        <<if $money >= _total>>
          <<set $money -= _total>>
          <<gainItem _id 1>>
          <<replace "#moneyDisplay">><<= $money>><</replace>>
          <<notify 1s>>获得了 <<= $shopDB[_id].icon ?? "📦">> <<= $shopDB[_id].name>><</notify>>
        <<else>>
          <<notify 1.5s>>工分不足！<</notify>>
        <</if>>
      <</button>>
    <</capture>>
  </div>
<</widget>>

/* 整页商店：按 $shopStockList 里配置的 id 列表展示 */
<<widget "shop">>
  <<set _shopId to $args[0] ?? "default">>
  <<set _list to ($shopStockList[_shopId] ?? [])>>

  <div id="shopPanel">
    <h2>《<<= _shopId>>》</h2>
    <div class="money">你持有：<span id="moneyDisplay"><<= $money>></span> 工分</div>

    <div class="goods">
      <<for _i = 0; _i < _list.length; _i++>>
        <<shopItem _list[_i]>>
      <</for>>
    </div>

  
  </div>
<</widget>>

<<script>>
document.head.insertAdjacentHTML('beforeEnd',`
<style>
#shopPanel{max-width:780px;width:100%;margin:auto;background:#222;color:#eee;padding:15px;border-radius:8px;box-sizing:border-box}
.money{text-align:right;margin-bottom:10px;font-weight:bold}
.goods{display:flex;flex-wrap:wrap;gap:12px}
.shopCard{background:#333;border:1px solid #555;padding:10px;border-radius:6px;width:220px;box-sizing:border-box;display:flex;flex-direction:column;gap:6px}
.shopCard .icon{font-size:32px;line-height:1}
.shopCard .name{font-weight:bold;display:block}
.shopCard .price{color:#ffcc00;font-weight:bold}
.shopCard .desc{font-size:0.9em;color:#aaa;display:block;font-weight:normal}
</style>
`);
<</script>>


:: 背包 [functional nobr no-history] {"position":"850,1200","size":"100,100"}
<h3>储物柜</h3>

<<if !$inv or $inv.length == 0>>
  <p><i>你的储物柜里目前还空无一物！去10L的商店购买一些东西吧！</i></p>
<<else>>
  /* 按 id 分组统计数量，用于展示；每一件的 uid 仍保留在 $inv 里，可用于装备/耐久/使用 */
  <<set _grouped to {}>>
  <<for _i = 0; _i < $inv.length; _i++>>
    <<set _it to $inv[_i]>>
    <<if !_grouped[_it.id]>>
      <<set _grouped[_it.id] to {count:0, uids:[]}>>
    <</if>>
    <<set _grouped[_it.id].count += 1>>
    <<run _grouped[_it.id].uids.push(_it.uid)>>
  <</for>>
  <<consumableList>>
  
<</if>>

<div class="inventory-preview">
  <h3>📦 当前装备</h3>
  <<set _slots to Object.keys($equip)>>
  <<set _hasAny to false>>
  <<for _s range _slots>>
    <<set _uid to $equip[_s]>>
    <<if _uid>>
      <<set _hasAny to true>>
      <<findInvIndexByUid _uid>>
      <<if _idx >= 0>>
        <<set _inst to $inv[_idx]>>
        <<set _def to $shopDB[_inst.id]>>
        <<= _s>>：<<= _def.icon ?? "📦">> <<= _def.name>><<if _def.desc>>（<<= _def.desc>>）<</if>>
        <<if typeof _inst.dur is "number">>（耐久：<<= _inst.dur>>）<</if>><br>
      <</if>>
    <</if>>
  <</for>>
  <<if !_hasAny>>
    <span style="color:#666">空</span>
  <</if>>
</div>

[[查看你现在拥有的所有物品]]
<<creturn 返回>>

:: 查看你现在拥有的所有物品[no-history nobr]
<<if !$inv or $inv.length == 0>>
  <p><i>你的储物柜里目前还空无一物！去10L的商店购买一些东西吧！</i></p>
<<else>>
你目前拥有的物品清点如下：
<<set _grouped to {}>>
  <<for _i = 0; _i < $inv.length; _i++>>
    <<set _it to $inv[_i]>>
    <<if !_grouped[_it.id]>>
      <<set _grouped[_it.id] to {count:0, uids:[]}>>
    <</if>>
    <<set _grouped[_it.id].count += 1>>
    <<run _grouped[_it.id].uids.push(_it.uid)>>
  <</for>>
<<for _id, _g range _grouped>>
    <<set _def to $shopDB[_id]>>
    <<if _def>>
      <<= _def.icon ?? "📦">> <<= _def.name>><<if _def.desc>>（<<= _def.desc>>）<</if>> ×<<= _g.count>>（估值：<<= _def.price>>）<br>
    <</if>>
  <</for>>
  <</if>>
<<creturn 返回>>
:: QuestWidgets [widget nobr]

<<widget "questunlock">>
	<<set _id = $args[0]>>
	<<if setup.questDefs[_id] and not $quests[_id]>>
		<<set $quests[_id] = {
			status: 'active',
			objectives: setup.questDefs[_id].objectives.map(function(){ return false; })
		}>>
		<<questtoast setup.questDefs[_id].title "解锁了新任务" "🆕">>
	<</if>>
	<<questrefresh>>
<</widget>>

<<widget "questobjective">>
	<<set _id = $args[0]>>
	<<set _idx = Number($args[1])>>
	<<set _done = $args[2]>>
	<<if $quests[_id] and Number.isFinite(_idx) and _idx >= 0 and _idx < $quests[_id].objectives.length>>
		<<set $quests[_id].objectives[_idx] = _done>>
	<</if>>
	<<if $quests[_id] and $quests[_id].objectives.every(function(o){ return o; }) and $quests[_id].status isnot 'completed'>>
		<<set $quests[_id].status = 'completed'>>
		<<questtoast setup.questDefs[_id].title ("任务「" + setup.questDefs[_id].title + "」完成！") "✅">>
    <<notify 1.5s>>你完成了一个任务分支！<</notify>>
	<</if>>
	<<questrefresh>>
<</widget>>

<<widget "questcomplete">>
	<<set _id = $args[0]>>
	<<set _idx = Number($args[1])>>
	<<if $quests[_id] and $quests[_id].status isnot 'completed'>>
		<<if Number.isFinite(_idx) and _idx >= 0 and _idx < $quests[_id].objectives.length>>
			<<set $quests[_id].objectives[_idx] = true>>
		<<else>>
			<<set $quests[_id].objectives = $quests[_id].objectives.map(function(){ return true; })>>
		<</if>>
		<<set $quests[_id].status = 'completed'>>
		<<questtoast setup.questDefs[_id].title ("任务「" + setup.questDefs[_id].title + "」完成！") "✅">>
    <<notify 1.5s>>你完成了一个任务！<</notify>>
	<</if>>
	<<questrefresh>>
<</widget>>

<<widget "achievement">>
	<<set _id = $args[0]>>
	<<if setup.achievementDefs[_id] and not $achievements[_id]>>
		<<set $achievements[_id] = true>>
		<<questtoast setup.achievementDefs[_id].title ("获得成就：" + setup.achievementDefs[_id].title) (setup.achievementDefs[_id].icon || "🏆")>>
	<</if>>
	<<questrefresh>>
<</widget>>

/* 内部用：刷新面板显示。若目标元素当前不在 DOM 里（比如正文触发时 footer 还没渲染），直接跳过——footer 稍后渲染时会自然带上最新状态 */
<<widget "questrefresh">>
	<<if $("#questBody").length>>
		<<replace "#questBody">><<include "QuestBodyRender">><</replace>>
	<</if>>
	<<if $("#questBadge").length>>
		<<replace "#questBadge">><<include "QuestBadgeRender">><</replace>>
	<</if>>
<</widget>>

/* 内部用：弹出提示 toast，同样加存在性判断 */
<<widget "questtoast">>
	<<set _title = $args[0]>>
	<<set _text = $args[1]>>
	<<set _icon = $args[2] || "🏆">>
	<<if $("#questToast").length>>
		<<replace "#toastIcon">>_icon<</replace>>
		<<replace "#toastTitle">>_title<</replace>>
		<<replace "#toastText">>_text<</replace>>
		<<addclass "#questToast" "active">>
		<<timed 3.5s>>
			<<removeclass "#questToast" "active">>
		<</timed>>
	<</if>>
<</widget>>

:: QuestBodyRender [nobr]
<div class="quest-toplevel-tabs">
	<span class="toplevel-tab <<if $questPanelTab is 'quest'>>active<</if>>"><<link "任务">><<set $questPanelTab = 'quest'>><<replace "#questBody">><<include "QuestBodyRender">><</replace>><</link>></span>
	<span class="toplevel-tab <<if $questPanelTab is 'achievement'>>active<</if>>"><<link "成就">><<set $questPanelTab = 'achievement'>><<replace "#questBody">><<include "QuestBodyRender">><</replace>><</link>></span>
</div>

<<if $questPanelTab is 'quest'>>
	<div class="quest-tabs">
		<span class="quest-tab <<if $questFilter is 'all'>>active<</if>>"><<link "全部">><<set $questFilter = 'all'>><<replace "#questBody">><<include "QuestBodyRender">><</replace>><</link>></span>
		<span class="quest-tab <<if $questFilter is 'active'>>active<</if>>"><<link "进行中">><<set $questFilter = 'active'>><<replace "#questBody">><<include "QuestBodyRender">><</replace>><</link>></span>
		<span class="quest-tab <<if $questFilter is 'completed'>>active<</if>>"><<link "已完成">><<set $questFilter = 'completed'>><<replace "#questBody">><<include "QuestBodyRender">><</replace>><</link>></span>
	</div>
	<div class="quest-scroll">
		<<include "QuestListRender">>
	</div>
<<else>>
	<div class="quest-scroll">
		<<include "AchievementListRender">>
	</div>
<</if>>


:: QuestListRender [nobr no-history]
<<set _ids = Object.keys($quests)>>
<<set _filtered = _ids.filter(function(id){
	if ($questFilter === 'active') return $quests[id].status !== 'completed';
	if ($questFilter === 'completed') return $quests[id].status === 'completed';
	return true;
})>>
<<if _filtered.length is 0>>
	<div class="empty-state">
		<div class="empty-icon">📭</div>
		<p><<if $questFilter is 'completed'>>还没有已完成的任务<<elseif $questFilter is 'active'>>没有进行中的任务<<else>>暂无任务<</if>></p>
	</div>
<<else>>
	<<for _i = 0; _i < _filtered.length; _i++>>
		<<set _id = _filtered[_i]>>
		<<set _def = setup.questDefs[_id]>>
		<<set _q = $quests[_id]>>
		<<set _total = _q.objectives.length>>
		<<set _done = _q.objectives.filter(function(o){ return o; }).length>>
		<<set _progress = Math.round(_done / _total * 100)>>
		<<set _isCompleted = _q.status is 'completed'>>
		<details class="quest-item <<if _isCompleted>>completed<<else>>active-quest<</if>>">
			<summary>
				<div class="quest-header">
					<h3 class="quest-title">_def.title</h3>
					<span class="quest-status <<if _isCompleted>>status-completed<<else>>status-progress<</if>>"><<if _isCompleted>>已完成<<else>>进行中<</if>></span>
				</div>
				<p class="quest-desc">_def.desc</p>
				<<if not _isCompleted>>
				<div class="quest-progress-bar"><div class="quest-progress-fill" style="width:_progress%"></div></div>
				<div class="quest-progress-text">_progress%</div>
				<</if>>
			</summary>
			<div class="quest-details">
				<div class="detail-section">
					<div class="detail-label">任务详情</div>
					<p class="detail-text">_def.details</p>
				</div>
				<div class="detail-section">
					<div class="detail-label">任务目标</div>
					<ul class="objective-list">
						<<for _j = 0; _j < _def.objectives.length; _j++>>
							<li class="objective-item <<if _q.objectives[_j]>>done<</if>>">_def.objectives[_j]</li>
						<</for>>
					</ul>
				</div>
				<<if _def.rewards.length gt 0>>
				<div class="detail-section">
					<div class="detail-label">任务奖励</div>
					<div class="quest-rewards">
						<<for _k = 0; _k < _def.rewards.length; _k++>>
							<span class="reward-tag">_def.rewards[_k]</span>
						<</for>>
					</div>
				</div>
				<</if>>
			</div>
		</details>
	<</for>>
<</if>>
<<creturn 返回>>

:: QuestBadgeRender [nobr]
<<set _count = Object.keys($quests).filter(function(id){ return $quests[id].status !== 'completed'; }).length>>
<<if _count gt 0>>_count<</if>>


:: AchievementListRender [nobr]
<<set _ids = Object.keys(setup.achievementDefs)>>
<<if _ids.length is 0>>
	<div class="empty-state"><div class="empty-icon">📭</div><p>暂无成就</p></div>
<<else>>
	<<for _i = 0; _i < _ids.length; _i++>>
		<<set _id = _ids[_i]>>
		<<set _def = setup.achievementDefs[_id]>>
		<<set _unlocked = $achievements[_id] ? true : false>>
		<div class="achievement-item <<if _unlocked>>unlocked<<else>>locked<</if>>">
			<div class="achievement-icon"><<if _unlocked>>_def.icon<<else>>🔒<</if>></div>
			<div class="achievement-body">
				<div class="achievement-title"><<if _unlocked>>_def.title<<else>>？？？<</if>></div>
				<div class="achievement-desc"><<if _unlocked>>_def.desc<<else>>尚未解锁<</if>></div>
			</div>
		</div>
	<</for>>
<</if>>


:: tasklistwidget [widget nobr] {"position":"825,750","size":"100,100"}
<<widget "tasklist">>
  /* 兜底：如果 $time 还没建立，就先给一个默认结构 */
  <<if !$time>>
    <<set $time to { day: 1, hour: 8, minute: 0, totalMinutes: 480 }>>
  <</if>>
<<if $enterpersonnel>>
  <<if $settled>>
    <<set $checktime to 7>>
  <<else>>
    <<set $checktime to ($time.day % 7 === 0 ? 0 : 7 - ($time.day % 7))>>
  <</if>>
  <<if $checktime > 0>>
    【下一次工分审核在 <<print $checktime>> 天以后，
  <<elseif $checktime == 0>>
    【公分审查就在今天！】
  <<else>>
    【公分审查就在明天！】
  <</if>>
  你需要至少挣到 <<print (2**$workgrade)*100>> 工分】
<</if>>
<</widget>>




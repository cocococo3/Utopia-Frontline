<<silentDayRoll>>

:: PassageReady
<<if $power <= 0&&!$priorpassage>>
  <<set $priorpassage to true>>
    /* 先重置，防止循环 */
    <<goto "lackpower">>
<<elseif $woreout >= 100 &&!$inCombat&&!$priorpassage>>
<<set $priorpassage to true>>
  <<set $woreout to 100>>
    <<goto "fullworeout">>
<<elseif $woreout >= 100 &&!$inCombat&&!$priorpassage&&$prosuperperception>>
  <<goto "解除超感知">>
<<elseif $superperception > 100&&!$priorpassage>>
  <<set $prosuperperception to true>>
<</if>>
<<set $superperception to Math.min($superperception, 100)>>
<<if $checktime <= 0 and !$settled>>
    <<goto "公分审查结算">>
<</if>>
<<if $protectionoilon&&$time.day>=$protectionoilondate+5>>
  <<notify 1.5s>>你身上的防护漆化为粉末脱落了……<</notify>>
  <<if $equippedCloth!=null>>
    <<set $equippedCloth.clothdirty+=10>>
  <</if>>
  <<set $protectionoilon to false>>
<</if>>
<<if $shoot<=Math.floor($fighting/3+$evade/3+$hiding/3)>>
    <<set $shoot to Math.floor($fighting/3+$evade/3+$hiding/3)>>
<</if>>


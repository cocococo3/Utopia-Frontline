    $('#info-time').text(State.variables.timeText);
  if (State.variables.power !== undefined)
    $('#info-power').text(State.variables.power);

  if (typeof window.refreshSidebarProgressBars === 'function') {
    window.refreshSidebarProgressBars();
  }
});
</script>


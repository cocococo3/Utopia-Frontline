:: 电子书[no-history nobr] {"position":"625,1575","size":"100,100"}
<div class="ebook-panel">
  <div class="ebook-header">
    <span class="ebook-header__title">电子档案</span>
    <span class="ebook-header__meta"><<= $ebookUnlocked ? $ebookUnlocked.length : 0>> / <<print Object.keys($ebookDB || {}).length>></span>
  </div>

  <<if !$ebookUnlocked || $ebookUnlocked.length == 0>>
    <div class="ebook-empty">
      <div class="ebook-empty__icon">◌</div>
      <div>你的芯片库是空的。</div>
    </div>
  <<else>>
    <div class="ebook-list">
      <<for _i = 0; _i < $ebookUnlocked.length; _i++>>
        <<set _id to $ebookUnlocked[_i]>>
        <<set _b to $ebookDB[_id]>>
        <<if _b>>
          <<capture _id, _b>>
            <div class="ebook-item">
              <div class="ebook-item__tag">记录</div>
              <div class="ebook-item__title"><<link _b.title>><<goto _b.passage>><</link>></div>
              <div class="ebookDesc"><<= _b.desc>></div>
            </div>
          <</capture>>
        <<else>>
          <<run console.warn("电子书条目缺失: " + _id)>>
        <</if>>
      <</for>>
    </div>
  <</if>>
</div>

<br>
<<creturn 返回>>



:: 电子书解锁widget [widget nobr no-history] {"position":"725,1475","size":"100,100"}
<<widget "unlockEbook">>
  <<set _id to $args[0]>>
  <<set _quiet to $args[1] ?? false>>
  <<set $ebookUnlocked to $ebookUnlocked ?? []>>
  <<if !$ebookDB[_id]>>
    <<run console.warn("unlockEbook: 未找到条目 " + _id)>>
  <<else>>
    <<if !$ebookUnlocked.includes(_id)>>
      <<set $ebookUnlocked.push(_id)>>
      <<if !_quiet>>
        你已解锁：''$ebookDB[_id].title''。<br>
      <</if>>
    <<else>>
      <<if !_quiet>>
        （该电子书已在你的芯片库中。）<br>
      <</if>>
    <</if>>
  <</if>>
<</widget>>





:: settings[no-history] {"position":"1050,1225","size":"100,100"}
<div class="settings-panel">

  <div class="toggle-row">
    <div class="toggle-label">侧边栏任务提示</div>

    <div class="toggle-right">
      <span class="toggle-ui js-optTaskHint-toggle"
        onclick="
          const v = SugarCube.State.variables;

          v.optTaskHint = !v.optTaskHint;
          this.classList.toggle('on', !!v.optTaskHint);

          const s = this.parentElement.querySelector('.toggle-state');
          if (s) s.textContent = v.optTaskHint ? 'ON' : 'OFF';

          if (window.UI && UI.update) UI.update();
        ">
      </span>

      <span class="toggle-state js-optTaskHint-state">OFF</span>
    </div>
  </div>

  <div class="toggle-row">
    <div class="toggle-label">音频总开关</div>

    <div class="toggle-right">
      <span class="toggle-ui js-optAudio-toggle"
        onclick="
          const v = SugarCube.State.variables;
          v.optAudio = !v.optAudio;
          this.classList.toggle('on', !!v.optAudio);

          const s = this.parentElement.querySelector('.toggle-state');
          if (s) s.textContent = v.optAudio ? 'ON' : 'OFF';
          if (typeof window.syncAudioSystemState === 'function') window.syncAudioSystemState();
          if (window.UI && UI.update) UI.update();
        ">
      </span>

      <span class="toggle-state js-optAudio-state">ON</span>
    </div>
  </div>

  <div class="toggle-row">
    <div class="toggle-label">播放背景音乐</div>

    <div class="toggle-right">
      <span class="toggle-ui js-optBgm-toggle"
        onclick="
          const v = SugarCube.State.variables;
          v.optBgm = !v.optBgm;
          this.classList.toggle('on', !!v.optBgm);

          const s = this.parentElement.querySelector('.toggle-state');
          if (s) s.textContent = v.optBgm ? 'ON' : 'OFF';

          if (typeof window.syncAudioSystemState === 'function') {
            window.syncAudioSystemState();
          } else if (typeof SimpleAudio !== 'undefined') {
            if (v.optAudio !== false && v.optBgm) {
              SimpleAudio.play('bgm_main');
            } else {
              SimpleAudio.stop('bgm_main');
            }
          }

          if (window.UI && UI.update) UI.update();
        ">
      </span>

      <span class="toggle-state js-optBgm-state">ON</span>
    </div>
  </div>

</div>

<script>
(function () {
  const v = SugarCube.State.variables;

  if (typeof v.optTaskHint === 'undefined') v.optTaskHint = false;
  if (typeof v.optAudio === 'undefined') v.optAudio = true;
  if (typeof v.optBgm === 'undefined') v.optBgm = true;

  const taskToggle = document.querySelector('.js-optTaskHint-toggle');
  const taskState  = document.querySelector('.js-optTaskHint-state');
  const audioToggle = document.querySelector('.js-optAudio-toggle');
  const audioState  = document.querySelector('.js-optAudio-state');
  const bgmToggle = document.querySelector('.js-optBgm-toggle');
  const bgmState  = document.querySelector('.js-optBgm-state');

  if (taskToggle) taskToggle.classList.toggle('on', !!v.optTaskHint);
  if (taskState)  taskState.textContent = v.optTaskHint ? 'ON' : 'OFF';
  if (audioToggle) audioToggle.classList.toggle('on', !!v.optAudio);
  if (audioState)  audioState.textContent = v.optAudio ? 'ON' : 'OFF';
  if (bgmToggle) bgmToggle.classList.toggle('on', !!v.optBgm);
  if (bgmState)  bgmState.textContent = v.optBgm ? 'ON' : 'OFF';

  if (typeof window.syncAudioSystemState === 'function') {
    window.syncAudioSystemState();
  } else if (typeof SimpleAudio !== 'undefined') {
    if (v.optAudio !== false && v.optBgm) {
      SimpleAudio.play('bgm_main');
    } else {
      SimpleAudio.stop('bgm_main');
    }
  }
})();
</script>



:: 设置widget [widget nobr] {"position":"1050,1325","size":"100,100"}
<<widget "toggleTaskHint">>
  <<silently>>
    <<set $optTaskHint to !$optTaskHint>>
    <<run typeof UI !== "undefined" && UI.update && UI.update()>>
  <</silently>>
<</widget>>

<<widget "toggleBgm">>
  <<silently>>
    <<set $optBgm to !$optBgm>>
    <<if $optBgm>>
      <<run if (typeof SimpleAudio !== "undefined") { SimpleAudio.play("bgm_main"); }>>
      <<else>>
      <<stopsounds>>
    <</if>>
  <</silently>>
<</widget>>
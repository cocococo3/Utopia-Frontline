你在人群中找到了那个女孩。<br>
/* 1L 商店的卖品统一从 $shopPool 读取，确保与物品数据库格式一致 */
<<set _tradeItems to Object.values($shopPool ?? {})>>
<<barterShop>>

<br><br>
[[返回走廊->L1流通走廊]]

<<else>>
你在人群中寻找，但没有找到那个女孩的身影，看起来今天她并不在这里。<br><br>
<</if>>[[返回走廊->L1流通走廊]]


:: 以物换物商店widget [widget nobr] {"position":"2750,650","size":"100,100"}
/* ==========================
   以物换物商店 · 统一物品格式适配版
   依赖前面统一版脚本里的：$shopDB、$inv、newUid、removeItemByUid
   物品估值统一用 $shopDB[id].price 代替旧的 val 字段
   NPC 库存 $npcShopStock 与玩家背包 $inv 同结构：[{id, uid, dur}, ...]
   ========================== */

<<widget "npcGainItem">>
  <<set _id  to $args[0]>>
  <<set _qty to $args[1] ?? 1>>
  <<set _def to ($shopDB[_id] ?? $shopPool[_id])>>

  <<if !_def>>
    <<run console.warn("npcGainItem: shopDB/shopPool 都不存在该 id:", _id)>>
    <<return>>
  <</if>>

  <<for _i range _qty>>
    <<newUid>>
    <<set _inst to { id:_id, uid:_uid, dur:(_def.wear ?? null) }>>
    <<run $npcShopStock.push(_inst)>>
  <</for>>
<</widget>>

/* 把一个实例数组（$inv / $npcShopStock / $tmp_myOffer 都适用）按 id 分组统计，
   结果写到临时变量 _groupResult = { id: {count, uids:[]} } */
<<widget "groupInstances">>
  <<set _arr to $args[0]>>
  <<set _grouped to {}>>
  <<for _i = 0; _i < _arr.length; _i++>>
    <<set _it to _arr[_i]>>
    <<if !_grouped[_it.id]>>
      <<set _grouped[_it.id] to {count:0, uids:[]}>>
    <</if>>
    <<set _grouped[_it.id].count += 1>>
    <<run _grouped[_it.id].uids.push(_it.uid)>>
  <</for>>
  <<set _groupResult to _grouped>>
<</widget>>

/* NPC 出售设置：每天刷新一次库存，从 $shopDB 随机抽 3~5 种物品 */
<<widget "barterShopSetupNPC">>
  <<set _today to $time.day || 1>>

  <<if !$npcShopDate or $npcShopDate != _today>>
    <<set $npcShopDate to _today>>
    <<set $npcShopStock to []>>
    <<set $tmp_npcOffer to []>>  /* 库存刷新了，之前挑的对方物品也作废 */

    <<set _keys to Object.keys($shopPool ?? {})>>
    <<if _keys.length == 0>>
      <<return>>
    <</if>>

    <<set _num to Math.min(_keys.length, random(3,5))>>
    <<set _picked to []>>

    <<for _i = 0; _i < _num; _i++>>
      <<set _pick to _keys[random(0, _keys.length - 1)]>>
      <<if _picked.indexOf(_pick) < 0>>
        <<run _picked.push(_pick)>>
        <<npcGainItem _pick random(1,3)>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

/* 玩家物品面板：点击把"一件"物品（具体某个uid）放入我方托盘 */
<<widget "barterPlayerPanel">>
  <h3>我方背包（点击加入）</h3>

  <<groupInstances $inv>>
  <<set _playerGrouped to _groupResult>>

  <<if Object.keys(_playerGrouped).length == 0>>
    <p><i>你的背包里什么都没有。</i></p>
  <<else>>
    <<for _id, _g range _playerGrouped>>
      <<set _def to ($shopDB[_id] ?? $shopPool[_id])>>
      <<if _def>>
        /* 已经放进托盘里的同款数量，要从可选数量里扣掉 */
        <<set _offeredCount to 0>>
        <<for _o range $tmp_myOffer>>
          <<if _o.id is _id>><<set _offeredCount += 1>><</if>>
        <</for>>
        <<set _avail to _g.count - _offeredCount>>

        <<if _avail > 0>>
          <<set _label to (_def.icon ?? "📦") + " " + _def.name + "（剩" + _avail + "）估值" + _def.price>>
          <<capture _id _g _label>>
            <<button _label>>
              /* 找一个还没被放进托盘的具体uid */
              <<set _availUid to null>>
              <<for _u range _g.uids>>
                <<set _used to false>>
                <<for _o range $tmp_myOffer>>
                  <<if _o.uid is _u>><<set _used to true>><<break>><</if>>
                <</for>>
                <<if !_used>><<set _availUid to _u>><<break>><</if>>
              <</for>>

              <<if _availUid>>
                <<run $tmp_myOffer.push({id:_id, uid:_availUid})>>
              <</if>>
              <<replace "#barterShopBox">><<barterShop>><</replace>>
            <</button>>
          <</capture>>
          <br>
        <</if>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

/* 我方托盘显示（可撤回） */
<<widget "barterMyTray">>
  <h3>我方托盘</h3>
  <<if !$tmp_myOffer or $tmp_myOffer.length == 0>>
    <p><i>你还没有放入任何物品。</i></p>
    <<set $tmp_myTotal to 0>>
  <<else>>
    <<groupInstances $tmp_myOffer>>
    <<set _myGrouped to _groupResult>>
    <<set _myTotal to 0>>

    <<for _id, _g range _myGrouped>>
      <<set _def to $shopDB[_id]>>
      <<if _def>>
        <<set _myTotal += _def.price * _g.count>>
        <<= _def.icon ?? "📦">> <<= _def.name>><<if _def.desc>>（<<= _def.desc>>）<</if>> ×<<= _g.count>> 估值 <<= _def.price>>
        <<capture _id>>
          <<link "（撤回一件）">>
            <<for _i = $tmp_myOffer.length - 1; _i >= 0; _i-- >>
              <<if $tmp_myOffer[_i].id is _id>>
                <<run $tmp_myOffer.deleteAt(_i)>>
                <<break>>
              <</if>>
            <</for>>
            <<replace "#barterShopBox">><<barterShop>><</replace>>
          <</link>>
        <</capture>>
        <br>
      <</if>>
    <</for>>

    <b>我方总价：<<= _myTotal>> 工分</b>
    <<set $tmp_myTotal to _myTotal>>
  <</if>>
<</widget>>

/* 对方库存：展示 NPC 手上所有货，点击把"一件"加入对方托盘 */
<<widget "barterNPCStockPanel">>
  <h3>对方库存（点击加入换取）</h3>

  <<groupInstances $npcShopStock>>
  <<set _npcStockGrouped to _groupResult>>

  <<if Object.keys(_npcStockGrouped).length == 0>>
    <p><i>对方没有任何可交换的物品。</i></p>
  <<else>>
    <<for _id, _g range _npcStockGrouped>>
      <<set _def to ($shopDB[_id] ?? $shopPool[_id])>>
      <<if _def>>
        /* 已经放进"对方托盘"里的同款数量，要从可选数量里扣掉 */
        <<set _offeredCount to 0>>
        <<for _o range $tmp_npcOffer>>
          <<if _o.id is _id>><<set _offeredCount += 1>><</if>>
        <</for>>
        <<set _avail to _g.count - _offeredCount>>

        <<if _avail > 0>>
          <<set _label to (_def.icon ?? "📦") + " " + _def.name + "（剩" + _avail + "）估值" + _def.price>>
          <<capture _id _g _label>>
            <<button _label>>
              /* 找一个还没被放进对方托盘的具体uid */
              <<set _availUid to null>>
              <<for _u range _g.uids>>
                <<set _used to false>>
                <<for _o range $tmp_npcOffer>>
                  <<if _o.uid is _u>><<set _used to true>><<break>><</if>>
                <</for>>
                <<if !_used>><<set _availUid to _u>><<break>><</if>>
              <</for>>

              <<if _availUid>>
                <<run $tmp_npcOffer.push({id:_id, uid:_availUid})>>
              <</if>>
              <<replace "#barterShopBox">><<barterShop>><</replace>>
            <</button>>
          <</capture>>
          <br>
        <</if>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

/* 对方托盘：已经选定、准备换给玩家的物品，可撤回 */
<<widget "barterNPCOfferTray">>
  <h3>对方提供（拟换给你的）</h3>
  <<if !$tmp_npcOffer or $tmp_npcOffer.length == 0>>
    <p><i>你还没有选择对方的任何物品。</i></p>
    <<set $tmp_npcTotal to 0>>
  <<else>>
    <<groupInstances $tmp_npcOffer>>
    <<set _npcOfferGrouped to _groupResult>>
    <<set _npcTotal to 0>>

    <<for _id, _g range _npcOfferGrouped>>
      <<set _def to ($shopDB[_id] ?? $shopPool[_id])>>
      <<if _def>>
        <<set _npcTotal += _def.price * _g.count>>
        <<= _def.icon ?? "📦">> <<= _def.name>><<if _def.desc>>（<<= _def.desc>>）<</if>> ×<<= _g.count>> 估值 <<= _def.price>>
        <<capture _id>>
          <<link "（撤回一件）">>
            <<for _i = $tmp_npcOffer.length - 1; _i >= 0; _i-- >>
              <<if $tmp_npcOffer[_i].id is _id>>
                <<run $tmp_npcOffer.deleteAt(_i)>>
                <<break>>
              <</if>>
            <</for>>
            <<replace "#barterShopBox">><<barterShop>><</replace>>
          <</link>>
        <</capture>>
        <br>
      <</if>>
    <</for>>

    <b>对方总价：<<= _npcTotal>> 工分</b>
    <<set $tmp_npcTotal to _npcTotal>>
  <</if>>
<</widget>>

/* 检定与成交判断（逻辑与原版一致，多了个"还没挑对方物品"的判断） */
<<widget "barterCheck">>
  <<set _myTotal  to $tmp_myTotal || 0>>
  <<set _npcTotal to $tmp_npcTotal || 0>>
  <<set _diff to _npcTotal - _myTotal>>

  <<if !$npcShopStock or $npcShopStock.length == 0>>
    <p>对方没有物品可交易。</p>
    <<button "离开">><<run Engine.play(passage())>><</button>>
  <<elseif !$tmp_npcOffer or $tmp_npcOffer.length == 0>>
    <p>你还没有挑选想跟对方换的物品。</p>
  <<elseif !_myTotal or _myTotal <= 0>>
    <p>你还没有放入任何物品。</p>
  <<elseif _diff <= 0>>
    <<button "成交">><<barterExec>><</button>>
  <<elseif _diff > 10>>
    <p>差价过大（<<= _diff>> 工分），对方不愿谈判。</p>
    <<button "离开">><<run Engine.play(passage())>><</button>>
  <<else>>
    <p>差价 <<= _diff>> 工分，可尝试砍价（口才检定）。</p>
    <<button "检定口才（d100 ≤ 口才技能）">>
      <<set _roll to random(1,100)>>
      <<if _roll <= ($skillEloquence || 0)>>
        <<notify 1.5s>>检定成功！对方同意降价。<</notify>>
        <<set $tmp_npcTotal to _myTotal>>
        <<replace "#barterShopBox">><<barterShop>><</replace>>
      <<else>>
        <<notify 1.5s>>检定失败（<<= _roll>> > <<= $skillEloquence>>），交易破裂。<</notify>>
        <<run Engine.play(passage())>>
      <</if>>
    <</button>>
  <</if>>
<</widget>>

/* 真正执行交易 */
<<widget "barterExec">>
  /* 玩家把托盘里的物品交出去：按 uid 精确从 $inv 移除 */
  <<if $tmp_myOffer and $tmp_myOffer.length > 0>>
    <<for _o range $tmp_myOffer>>
      <<removeItemByUid _o.uid>>
    <</for>>
  <</if>>

  /* 把玩家挑选的那部分 NPC 物品，按 uid 精确从 $npcShopStock 移到 $inv */
  <<if $tmp_npcOffer and $tmp_npcOffer.length > 0>>
    <<for _o range $tmp_npcOffer>>
      <<set _ni to -1>>
      <<for _i = 0; _i < $npcShopStock.length; _i++>>
        <<if $npcShopStock[_i].uid is _o.uid>>
          <<set _ni to _i>>
          <<break>>
        <</if>>
      <</for>>
      <<if _ni >= 0>>
        <<run $inv.push($npcShopStock[_ni])>>
        <<run $npcShopStock.deleteAt(_ni)>>
      <</if>>
    <</for>>
  <</if>>

  <<set $tmp_myOffer to []>>
  <<set $tmp_npcOffer to []>>
  <<unset $tmp_npcTotal>>
  <<unset $tmp_myTotal>>
  <<notify 2s>>交易完成！<</notify>>
  <<run Engine.play(passage())>>
<</widget>>

/* 主入口 */
<<widget "barterShop">>
  <<barterShopSetupNPC>>
  <<if !$tmp_myOffer>><<set $tmp_myOffer to []>><</if>>
  <<if !$tmp_npcOffer>><<set $tmp_npcOffer to []>><</if>>

  <div id="barterShopBox">
    <div class="barterPanel">
      <div class="leftCol"><<barterPlayerPanel>></div>
      <div class="midCol">
        <<barterMyTray>>
        <hr>
        <<barterNPCStockPanel>>
        <hr>
        <<barterNPCOfferTray>>
        <hr>
        <<barterCheck>>
      </div>
    </div>
  </div>
<</widget>>

/* 样式 */
<<script>>
document.head.insertAdjacentHTML('beforeend',`
<style>
.barterPanel{display:flex;gap:20px}
.leftCol{width:40%}
.midCol{flex:1}
hr{border:0;border-top:1px solid #888;margin:6px 0}
i{color:#888}
</style>
`);
<</script>>

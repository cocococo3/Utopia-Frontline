/* 伤害类型 -> AI 标签 */
<<set $aiTagByDmg to {
  "物理":     { style:"aggressive", note:"近战压迫/更爱普通攻击" },
  "化学":     { style:"toxic",      note:"偏施加减益/腐蚀" },
  "通信阻断": { style:"jammer",     note:"偏打断/延后巡逻" },
  "错误化": { style:"errorization",     note:"持续回血" }
}>>

/* 主AI优先级：多类型时，命中越靠前越优先当主AI */
<<set $aiPriority to ["物理","化学","通信阻断","错误化"]>>

/* n型数值规则（可调平衡） */
<<set $byN to {
  1:{ baseHp:50,  hpRange:10, baseAtk:12, atkRange:2 },
  2:{ baseHp:70,  hpRange:15, baseAtk:16, atkRange:3 },
  3:{ baseHp:95,  hpRange:20, baseAtk:20, atkRange:4 },
  4:{ baseHp:125, hpRange:25, baseAtk:24, atkRange:5 }
}>>

/* 组合表（15 种）
   - key: 内部ID
   - dmg: 伤害类型数组（顺序会影响名字关键词拼接的顺序）
*/
<<set $dmgCombos to {
  /* 1种（4） */
  p:   { dmg:["物理"] },
  c:   { dmg:["化学"] },
  j:   { dmg:["通信阻断"] },
  i:   { dmg:["错误化"] },

  /* 2种（6） */
  pc:  { dmg:["物理","化学"] },
  pj:  { dmg:["物理","通信阻断"] },
  pi:  { dmg:["物理","错误化"] },
  cj:  { dmg:["化学","通信阻断"] },
  ci:  { dmg:["化学","错误化"] },
  ji:  { dmg:["通信阻断","错误化"] },

  /* 3种（4） */
  pcj: { dmg:["物理","化学","通信阻断"] },
  pci: { dmg:["物理","化学","错误化"] },
  pji: { dmg:["物理","通信阻断","错误化"] },
  cji: { dmg:["化学","通信阻断","错误化"] },

  /* 4种（1） */
  pcji:{ dmg:["物理","化学","通信阻断","错误化"] }
}>>

/* 组合 key 池：用于 random 抽取 */
<<set $dmgComboKeys to ["p","c","j","i","pc","pj","pi","cj","ci","ji","pcj","pci","pji","cji","pcji"]>>
<</silently>>

<<silently>>

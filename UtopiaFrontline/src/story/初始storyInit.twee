    ink: {name:"墨水渍", cleaners:["alcohol","bleach"], dissolvers:["water"]},
    mud:     {name:"灰尘", cleaners:["water","soap","alcohol","bleach","degreaser","enzyme"],    dissolvers:["acid"]},
    stuck:{name:"顽固污渍", cleaners:["acid"]}
}>>

<<set setup.cleaners = {
    water:"纯水", soap:"中性皂液", bleach:"漂白剂",
    enzyme:"生物酶清洁剂", degreaser:"去油剂",
    alcohol:"酒精喷雾", acid:"强酸溶液（危险）"
}>>

/* 当前衣服 */
<<set $cloth = {}>>


/* 工艺库：每道工序有哪些可选工艺，以及它们适用的“原料→产品”组合 */
<<set setup.processes = {
 chem: {   /* 化学处理 */
        "脂肪→肥皂": "碱性水解",
        "环己酮→己二酸": "氧化反应",
        "水杨酸→阿司匹林": "酯化反应",
        "玉米淀粉→聚乳酸": "碱性水解",
        "蒽醌→过氧化氢": "氧化反应",
        "乙酸乙酯→乙酰乙酸乙酯": "酯化反应",
        "牛奶蛋白→酪蛋白酸钠": "碱性水解",
        "苯胺→聚苯胺": "氧化反应"
    },
    sep:  {   /* 分离纯化 */
        "脂肪→肥皂": "过滤干燥",
        "环己酮→己二酸": "蒸馏结晶",
        "水杨酸→阿司匹林": "萃取重结晶",
        "玉米淀粉→聚乳酸": "蒸馏结晶",
        "蒽醌→过氧化氢": "萃取重结晶",
        "乙酸乙酯→乙酰乙酸乙酯": "过滤干燥",
        "牛奶蛋白→酪蛋白酸钠": "萃取重结晶",
        "苯胺→聚苯胺": "过滤干燥"
    },
    post: {   /* 后处理与成型 */
        "脂肪→肥皂": "造粒包装",
        "环己酮→己二酸": "喷雾干燥",
        "水杨酸→阿司匹林": "注塑成型",
        "玉米淀粉→聚乳酸": "注塑成型",
        "蒽醌→过氧化氢": "造粒包装",
        "乙酸乙酯→乙酰乙酸乙酯": "喷雾干燥",
        "牛奶蛋白→酪蛋白酸钠": "喷雾干燥",
        "苯胺→聚苯胺": "注塑成型"
    }
}>>

/* 订单库：原料、产品、价格 */
<<set setup.orders = [
    {ing:"脂肪", prod:"肥皂", pay:20},
    {ing:"环己酮", prod:"己二酸", pay:30},
    {ing:"水杨酸", prod:"阿司匹林", pay:50},
    {ing:"玉米淀粉", prod:"聚乳酸", pay:40},  // 生物塑料附加值较高
    {ing:"蒽醌", prod:"过氧化氢", pay:35},    // 氧化剂生产中等利润
    {ing:"乙酸乙酯", prod:"乙酰乙酸乙酯", pay:60}, // 医药中间体价格高
    {ing:"牛奶蛋白", prod:"酪蛋白酸钠", pay:25}, // 食品添加剂
    {ing:"苯胺", prod:"聚苯胺", pay:70}       // 功能材料溢价
]>>

<<run if (!Math.clamp) {
	window.Math.clamp = function (val, min, max) {
		return Math.min(Math.max(val, min), max);
	};
}>>



/* ---------- 离散选项定义（编号 → 修正/基础） ---------- */
/* 下摆：编号1..5 → 修正值（用于 maxworeout），并有名字 */
<<set $hemOpts to {
  1: { name: "无下摆",   mod: -6 },
  2: { name: "超短裙",   mod: -3 },
  3: { name: "普通短裙", mod:  0 },
  4: { name: "过膝裙",   mod: +3 },
  5: { name: "过踝裙",   mod: +6 }
}>>

/* 袖部：编号1..4 → 修正值 */
<<set $slvOpts to {
  1: { name: "无袖", mod: -3 },
  2: { name: "短袖", mod: -1 },
  3: { name: "中袖", mod: +3 },
  4: { name: "长袖", mod: +5 }
}>>

/* 布料：编号1..3 → 基础耐久 & 基础单价 */
<<set $fabOpts to {
  1: { name: "低耐受", baseMax: 10, baseMoney: 10 },

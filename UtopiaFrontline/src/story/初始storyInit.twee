:: StoryInit [functional nobr] {"position":"975,1050","size":"100,100"}
<<script>>Config.history.controls = false
<</script>>
/*关闭侧边后退按钮*/
<<set $optTaskHint = $optTaskHint ?? true>>
<<set $optAudio = $optAudio ?? true>>
<<set $optBgm = $optBgm ?? true>>

<<script>>
  window.audioUnlocked = false;

  function unlockAudio() {
    if (window.audioUnlocked) return;
    window.audioUnlocked = true;
    document.removeEventListener('pointerdown', unlockAudio);
    document.removeEventListener('keydown', unlockAudio);
    if (typeof window.syncAudioSystemState === 'function') {
      window.syncAudioSystemState();
    }
  }

  document.addEventListener('pointerdown', unlockAudio, { once: true });
  document.addEventListener('keydown', unlockAudio, { once: true });

  if (!window.playOneShot) {
    window.playOneShot = function (file, volume, loop) {
      try {
        if (!window.audioUnlocked) return;
        if (typeof window.isAudioGloballyEnabled === 'function' && !window.isAudioGloballyEnabled()) return;

        var audio = new Audio(file);
        audio.volume = (typeof volume === 'number') ? volume : 0.7;
        audio.loop = !!loop;
        audio.currentTime = 0;
        audio.play().then(function () {
          console.log('短音效播放成功:', file);
        }).catch(function (e) {
          console.warn('短音效播放失败:', file, e);
        });
      } catch (e) {
        console.warn('播放短音效失败:', e);
      }
    };
  }
<</script>>

<<include '查看工序合集'>>
/* ========== 基础状态 ========== */
<<set $settled to false>>/*是否已经经历过公分审查 */
<<set $inevent to false>>
<<set $difficulty to "normal">>
<<set $disastercountdown to 120>>
<<set $playerPos to  {layer:5, block:"维修部"}>>
<<set $power to 100>>          /*电量：100 → 0 */
<<if $power < 0>><<set $power = 0>><</if>>
<<if $power > 100>><<set $power = 100>><</if>>
<<set $woreout to 0>>          /* 磨损：0 → 100 */
<<if $woreout < 0>><<set $woreout = 0>><</if>>
<<if $woreout > 100>><<set $woreout = 100>><</if>>
